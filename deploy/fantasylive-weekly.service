##############################################################################
# Resumen semanal de creadoras - se dispara desde fantasylive-weekly.timer
# Instalar en /etc/systemd/system/fantasylive-weekly.service
##############################################################################

[Unit]
Description=FantasyLive - resumen semanal de creadoras
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=fantasylive
Group=fantasylive
WorkingDirectory=/var/www/fantasylive
EnvironmentFile=/var/www/fantasylive/.env
Environment=NODE_ENV=production

# --conditions=react-server permite importar modulos marcados "server-only".
ExecStart=/usr/bin/npx tsx --conditions=react-server scripts/weekly-creator-summary.mts

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# npx y tsx necesitan escribir cache
ReadWritePaths=/var/www/fantasylive/.next /var/www/fantasylive/node_modules /home/fantasylive
