##############################################################################
# SeaweedFS (almacenamiento S3 propio) - unidad systemd
# Instalar en /etc/systemd/system/seaweedfs.service
#
# La instala deploy/setup-storage.sh, que tambien crea el usuario de servicio,
# /var/lib/seaweedfs y /etc/seaweedfs/s3.json con las credenciales de la app.
#
# Todo escucha solo en 127.0.0.1: desde fuera se entra por nginx con HTTPS
# (deploy/nginx-storage.conf), nunca directamente a estos puertos.
#
# Puertos propios, lejos de los de por defecto: LiveKit Ingress ya usa el 8080
# (su healthcheck), que es el del volumen de SeaweedFS si no se cambia. Cada
# servicio abre ademas su puerto gRPC en +10000 (28080, 28888, 29333).
##############################################################################

[Unit]
Description=SeaweedFS (almacenamiento S3 de FantasyLive)
Documentation=https://github.com/seaweedfs/seaweedfs/wiki
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seaweedfs
Group=seaweedfs
ExecStart=/usr/local/bin/weed server \
  -dir=/var/lib/seaweedfs \
  -ip=127.0.0.1 -ip.bind=127.0.0.1 \
  -master.port=19333 -volume.port=18080 -filer.port=18888 \
  -volume.max=0 \
  -s3 -s3.port=18333 -s3.config=/etc/seaweedfs/s3.json

Restart=always
RestartSec=5
LimitNOFILE=65536
TimeoutStopSec=30

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# /tmp tambien: SeaweedFS escribe ahi su log y los sockets unix con los que
# sus partes (master, volumen, filer) y "weed shell" hablan entre si. Con
# ProtectSystem=strict y sin esto, /tmp es de solo lectura y el master no
# arranca. Compartido (sin PrivateTmp) para que setup-storage.sh pueda usar
# "weed shell" desde fuera del servicio.
ReadWritePaths=/var/lib/seaweedfs /tmp
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
