// =============================================================================
// FantasyLive - Prisma Schema
// PostgreSQL + Prisma ORM
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum Role {
  USER
  MODEL
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

enum Gender {
  FEMALE
  MALE
  TRANS_FEMALE
  TRANS_MALE
  NON_BINARY
  COUPLE
}

enum Orientation {
  STRAIGHT
  GAY
  LESBIAN
  BISEXUAL
  PANSEXUAL
  QUEER
  ASEXUAL
}

enum ModelTier {
  STANDARD
  VIP
  ELITE
}

enum CallType {
  RANDOM // Omegle-style gratuito / bajo costo
  VIP_RANDOM // Aleatorio solo con modelos VIP, cobro por minuto
  PRIVATE // 1 a 1 reservado con una modelo concreta
}

enum CallStatus {
  PENDING
  ACTIVE
  ENDED
  CANCELLED
  FAILED
}

enum CallEndReason {
  USER_HANGUP
  PARTNER_HANGUP
  NEXT_SKIP
  INSUFFICIENT_TOKENS
  TIMEOUT
  DISCONNECTED
  MODERATION
  /// Se agotaron los minutos gratis de la prueba
  FREE_LIMIT_REACHED
}

enum QueueMode {
  RANDOM
  VIP
}

enum QueueStatus {
  WAITING
  MATCHED
  CANCELLED
  EXPIRED
}

enum TransactionType {
  TOKEN_PURCHASE // usuario compra tokens (+)
  SIGNUP_BONUS // regalo de bienvenida (+)
  ADMIN_CREDIT // ajuste manual admin (+)
  ADMIN_DEBIT // ajuste manual admin (-)
  CALL_CHARGE // consumo por minuto (-)
  CALL_EARNING // ingreso de la modelo (+)
  CONTENT_UNLOCK // desbloqueo de pack (-)
  CONTENT_EARNING // ingreso de la modelo por pack (+)
  TIP // propina enviada (-)
  TIP_EARNING // propina recibida (+)
  BOOKING_HOLD // retencion al reservar (-)
  BOOKING_REFUND // devolucion por cancelacion (+)
  PAYOUT // retiro de la modelo (-)
  REFUND // devolucion al usuario (+)
  PLATFORM_FEE // comision de la plataforma
  SUBSCRIPTION_PURCHASE // usuario paga suscripcion mensual (-)
  SUBSCRIPTION_EARNING // ingreso de la modelo por suscripcion (+)
  CONTENT_REQUEST_PAYMENT // usuario paga un pedido de contenido a medida (-)
  CONTENT_REQUEST_EARNING // ingreso de la modelo por un pedido (+)
  MESSAGE_UNLOCK // usuario paga para abrir una conversacion (-)
  MESSAGE_UNLOCK_EARNING // ingreso de la modelo por abrir conversacion (+)
  MESSAGE_ATTACHMENT_UNLOCK // usuario paga por un archivo adjunto (-)
  MESSAGE_ATTACHMENT_EARNING // ingreso de la modelo por un archivo adjunto (+)
  POST_UNLOCK // usuario desbloquea una publicacion del feed (-)
  POST_EARNING // ingreso de la modelo por una publicacion (+)
  /// Comision de retiro (10%): se descuenta al solicitar el payout
  PAYOUT_FEE
  /// Programa de referidos: % de lo que genera una creadora invitada (+)
  REFERRAL_EARNING
  /// Tokens que un distribuidor oficial le envia a un fan (+). Cuentan como
  /// comprados: no se pueden retirar.
  DISTRIBUTOR_CREDIT
}

/// Quien puede escribirle a una cuenta (ajuste de privacidad).
enum MessagePrivacy {
  EVERYONE
  FOLLOWING
  NOBODY
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

enum ContentRequestStatus {
  PENDING // esperando cotizacion de la modelo
  QUOTED // modelo coloco un precio, esperando pago
  PAID // usuario pago, la modelo debe entregar
  DELIVERED // contenido entregado y desbloqueado
  DECLINED // la modelo rechazo el pedido
  CANCELLED // el usuario cancelo antes de pagar
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  CCBILL
  CRYPTO
  MOCK
  INTERNAL
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum DocumentType {
  PASSPORT
  NATIONAL_ID
  DRIVERS_LICENSE
}

enum BookingStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_USER
  CANCELLED_BY_MODEL
  NO_SHOW
  REFUNDED
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PROCESSING
  PAID
  REJECTED
}

enum PayoutMethod {
  /// Transferencia bancaria internacional (wire/SWIFT o SEPA)
  WIRE_TRANSFER
  /// USDT sobre la red TRON (TRC20)
  USDT_TRC20
  PAYPAL
  // Heredados: no se ofrecen en el formulario, se conservan por historico
  BANK_TRANSFER
  CRYPTO
  PAXUM
}

enum ReportReason {
  UNDERAGE
  NON_CONSENSUAL
  HARASSMENT
  SPAM
  IMPERSONATION
  PAYMENT_DISPUTE
  TECHNICAL_ISSUE
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
  ESCALATED
}

enum NotificationType {
  NEW_FOLLOWER
  NEW_SUBSCRIBER
  NEW_REVIEW
  CONTENT_REQUEST_RECEIVED
  CONTENT_REQUEST_QUOTED
  CONTENT_REQUEST_DELIVERED
  NEW_MESSAGE
  MESSAGE_ATTACHMENT_UNLOCKED
  /// Alguien esta llamando ahora mismo
  INCOMING_CALL
  /// Una creadora a la que sigues acaba de empezar un directo
  LIVE_STARTED
  /// Nueva publicacion en el feed de alguien a quien sigues
  NEW_POST
  /// Has recibido un regalo en tokens
  GIFT_RECEIVED
  /// Como va una publicacion propia (fase de prueba superada, hitos de vistas)
  POST_INSIGHT
  /// Aviso del equipo de moderacion (p. ej. publicacion retirada)
  MODERATION
  /// Aviso general del equipo a todos (o a un grupo)
  ANNOUNCEMENT
  /// El equipo ha respondido a tu consulta de soporte
  SUPPORT_REPLY
}

enum LiveStreamStatus {
  /// Sala creada y credenciales de OBS listas, pero sin video todavia
  PREPARING
  /// Emitiendo: aparece en la portada y en /live
  LIVE
  ENDED
}

/// Como se emite el directo. Determina si hay que crear un ingress RTMP.
enum LiveStreamSource {
  /// Camara del navegador (WebRTC directo a LiveKit)
  BROWSER
  /// OBS / Streamlabs por RTMP a traves de LiveKit Ingress
  OBS_RTMP
}

enum PostVisibility {
  /// Visible para cualquiera
  PUBLIC
  /// Se ve borroso hasta pagar priceTokens
  LOCKED
  /// Incluido en la suscripcion: solo suscriptores activos
  SUBSCRIBERS
}

/// De donde viene una visita registrada para las analiticas de la creadora.
enum VisitSource {
  PROFILE
  LIVE
  POST
}

// =============================================================================
// AUTENTICACION (NextAuth / Auth.js)
// =============================================================================

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  emailVerified     DateTime?
  passwordHash      String?
  /// Ultimo cambio de contraseña: las sesiones abiertas antes se cierran.
  passwordChangedAt DateTime?
  /// Paises desde los que se ha conectado alguna vez (sin VPN). Un perfil que
  /// bloquea uno de ellos sigue bloqueado aunque despues entre con VPN.
  seenCountries     String[]   @default([])
  name              String?
  username          String?    @unique
  image             String?
  role              Role       @default(USER)
  status            UserStatus @default(ACTIVE)

  // Perfil / compliance
  birthDate       DateTime?
  ageVerified     Boolean        @default(false)
  gender          Gender?
  orientation     Orientation?
  country         String?
  city            String?
  languages       String[]       @default([])
  bio             String?
  /// Perfil de fan visible para todos. Privado por defecto: solo se ve el
  /// nombre y la foto hasta que la persona decide abrirlo.
  isProfilePublic Boolean        @default(false)
  /// Quien puede escribirle. Aunque sea "todos", quien no se siguen llega
  /// como solicitud de mensaje.
  messagePrivacy  MessagePrivacy @default(EVERYONE)

  // Gustos (preguntas de bienvenida): ordenan su Descubrir.
  /// A quien quiere ver. Vacio = a todos.
  preferredGenders Gender[]  @default([])
  /// Etiquetas que le gustan (las mismas que ponen las creadoras).
  interests        String[]  @default([])
  /// Que busca: fotos, directos, chatear, videollamadas.
  lookingFor       String[]  @default([])
  /// Cuando respondio (o se salto) las preguntas. null = aun no.
  onboardedAt      DateTime?

  /// Programa de referidos: la creadora que trajo esta cuenta (por su
  /// enlace). Si esta cuenta es fan, lo que gaste con ella le deja mas a la
  /// creadora; si se hace creadora, la que la invito cobra un %.
  referredById         String?
  referredBy           User?                 @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  couponsReceived      CreatorOffer[]        @relation("CouponFan")
  distributor          Distributor?
  distributorCredits   DistributorTransfer[] @relation("DistributorRecipient")
  distributorPurchases DistributorSale[]     @relation("DistributorBuyer")
  referrals            User[]                @relation("Referrals")
  /// Reclutador que trajo a esta cuenta (solo trae creadoras; cobra un %).
  recruitedById        String?
  recruitedBy          Recruiter?            @relation("RecruitedBy", fields: [recruitedById], references: [id], onDelete: SetNull)
  /// Si esta cuenta es de un reclutador, sus condiciones.
  recruiterAccount     Recruiter?            @relation("RecruiterAccount")
  supportTickets       SupportTicket[]
  supportMessages      SupportMessage[]
  pushSubscriptions    PushSubscription[]
  postImpressions      PostImpression[]
  postHides            PostHide[]

  // Estado de plataforma
  isVip          Boolean   @default(false)
  vipUntil       DateTime?
  lastSeenAt     DateTime?
  suspendedUntil DateTime?
  banReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones NextAuth
  accounts Account[]
  sessions Session[]

  // Relaciones de dominio
  wallet                   Wallet?
  modelProfile             ModelProfile?
  transactions             Transaction[]             @relation("UserTransactions")
  callsInitiated           CallSession[]             @relation("CallCaller")
  callsReceived            CallSession[]             @relation("CallCallee")
  queueEntries             MatchQueueEntry[]
  bookings                 Booking[]                 @relation("BookingUser")
  giftsSent                Gift[]                    @relation("GiftSender")
  giftsReceived            Gift[]                    @relation("GiftReceiver")
  reportsFiled             Report[]                  @relation("Reporter")
  reportsAgainst           Report[]                  @relation("ReportedUser")
  reportsReviewed          Report[]                  @relation("ReportReviewer")
  kycReviewed              KycVerification[]         @relation("KycReviewer")
  payoutsProcessed         PayoutRequest[]           @relation("PayoutProcessor")
  auditLogs                AuditLog[]
  blocksMade               BlockedPair[]             @relation("Blocker")
  blocksReceived           BlockedPair[]             @relation("Blocked")
  follows                  Follow[]
  subscriptions            Subscription[]
  contentRequests          ContentRequest[]
  conversations            Conversation[]
  messagesSent             Message[]
  messageAttachmentUnlocks MessageAttachmentUnlock[]
  notifications            Notification[]
  postUnlocks              PostUnlock[]
  postLikes                PostLike[]
  postPollVotes            PostPollVote[]
  /// Personas (no creadoras) a las que sigue y que le siguen.
  userFollowing            UserFollow[]              @relation("UserFollowing")
  userFollowers            UserFollow[]              @relation("UserFollowers")
  peerChatsA               PeerChat[]                @relation("PeerChatA")
  peerChatsB               PeerChat[]                @relation("PeerChatB")
  peerMessages             PeerMessage[]
  postComments             PostComment[]
  profileVisits            ProfileVisit[]
  greetingsReceived        AutoGreetingLog[]
  liveViews                LiveView[]
  /// Inicio de la oferta "Te echamos de menos" (48 h tras 30 dias sin comprar).
  winbackOfferStartedAt    DateTime?
  authTokens               AuthToken[]
  devices                  UserDevice[]

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum AuthTokenKind {
  PASSWORD_RESET
  /// Codigo OTP de 6 cifras para confirmar el email.
  EMAIL_VERIFY
  /// Enlace al email nuevo para confirmar un cambio de email.
  EMAIL_CHANGE
}

/// Enlace de un solo uso enviado por email (recuperar contraseña, verificar
/// email). Solo se guarda el hash del token: quien lea la base de datos no
/// puede usar los enlaces.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  /// Intentos fallidos (codigos OTP: se invalida al 5.o).
  attempts  Int           @default(0)
  /// Dato extra: el email nuevo en EMAIL_CHANGE.
  payload   String?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, createdAt])
  @@map("auth_tokens")
}

/// Dispositivos desde los que ha entrado cada cuenta (para avisar de un
/// inicio de sesion desde uno nuevo). deviceKey = hash de sistema + navegador.
model UserDevice {
  id          String   @id @default(cuid())
  userId      String
  deviceKey   String
  label       String
  lastIp      String?
  lastCountry String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceKey])
  @@map("user_devices")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =============================================================================
// MONEDERO Y ECONOMIA DE TOKENS
// =============================================================================

model Wallet {
  id     String @id @default(cuid())
  userId String @unique

  /// Saldo disponible para gastar
  balance         Int @default(0)
  /// Tokens retenidos por reservas pendientes (no gastables)
  heldBalance     Int @default(0)
  /// Tokens ganados pendientes de retiro (solo modelos)
  pendingEarnings Int @default(0)

  // Contadores historicos (para dashboards, evita agregaciones costosas)
  lifetimePurchased Int @default(0)
  lifetimeSpent     Int @default(0)
  lifetimeEarned    Int @default(0)
  lifetimeWithdrawn Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model TokenPackage {
  id          String  @id @default(cuid())
  sku         String  @unique
  name        String
  description String?
  tokens      Int
  bonusTokens Int     @default(0)
  priceCents  Int
  currency    String  @default("USD")
  isActive    Boolean @default(true)
  isPopular   Boolean @default(false)
  sortOrder   Int     @default(0)

  // IDs externos de la pasarela
  stripePriceId String?
  ccbillFormId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([isActive, sortOrder])
  @@map("token_packages")
}

model Transaction {
  id     String            @id @default(cuid())
  userId String
  type   TransactionType
  status TransactionStatus @default(COMPLETED)

  /// Delta de tokens con signo: positivo acredita, negativo debita
  tokens       Int
  /// Saldo del monedero despues del movimiento (snapshot de auditoria)
  balanceAfter Int?

  /// Importe en fiat (centavos) cuando aplica compra/retiro
  amountCents Int?
  currency    String?

  provider    PaymentProvider @default(INTERNAL)
  providerRef String?         @unique

  description String?
  metadata    Json?

  // Vinculos opcionales al origen del movimiento
  tokenPackageId      String?
  callSessionId       String?
  bookingId           String?
  giftId              String? @unique
  payoutRequestId     String?
  subscriptionId      String?
  contentRequestId    String?
  conversationId      String?
  messageAttachmentId String?
  postId              String?
  liveStreamId        String?

  /// Comision retenida por la plataforma en este movimiento (tokens)
  platformFeeTokens Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User               @relation("UserTransactions", fields: [userId], references: [id], onDelete: Cascade)
  tokenPackage      TokenPackage?      @relation(fields: [tokenPackageId], references: [id], onDelete: SetNull)
  callSession       CallSession?       @relation(fields: [callSessionId], references: [id], onDelete: SetNull)
  booking           Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  gift              Gift?              @relation(fields: [giftId], references: [id], onDelete: SetNull)
  payoutRequest     PayoutRequest?     @relation(fields: [payoutRequestId], references: [id], onDelete: SetNull)
  subscription      Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  contentRequest    ContentRequest?    @relation(fields: [contentRequestId], references: [id], onDelete: SetNull)
  conversation      Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageAttachment MessageAttachment? @relation(fields: [messageAttachmentId], references: [id], onDelete: SetNull)
  post              Post?              @relation(fields: [postId], references: [id], onDelete: SetNull)
  liveStream        LiveStream?        @relation(fields: [liveStreamId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, status])
  @@index([createdAt])
  @@map("transactions")
}

// =============================================================================
// PERFIL DE MODELO
// =============================================================================

model ModelProfile {
  id     String @id @default(cuid())
  userId String @unique

  /// "Fundadora" n.o 1-100: de las 100 primeras creadoras verificadas. Su %
  /// por invitar creadoras es para siempre (las demas, 12 meses).
  founderNumber Int?      @unique
  /// Destacada por el equipo hasta esta fecha: sale mas en Descubrir.
  featuredUntil DateTime?

  // ---------------------------------------------------------------------------
  // TRATO NEGOCIADO (lo pone el equipo desde admin; ver src/lib/deals.ts)
  // Mientras esta vigente sustituye a los % estandar. null = el estandar.
  // ---------------------------------------------------------------------------
  /// % que retiene la plataforma de sus ventas (estandar: PLATFORM_COMMISSION_PERCENT).
  dealPlatformPercent   Int?
  /// % que cobra por cada creadora que invite (estandar: 5%).
  dealAmbassadorPercent Int?
  /// Fin del trato. null = sin fecha de fin.
  dealUntil             DateTime?
  /// Lo acordado, para el equipo (no lo ve la creadora).
  dealNotes             String?
  dealUpdatedAt         DateTime?

  /// Boveda: precio sugerido (tokens) de cada nivel de contenido de pago.
  vaultPriceLevel1  Int @default(30)
  vaultPriceLevel2  Int @default(60)
  vaultPriceLevel3  Int @default(100)
  vaultPriceSpecial Int @default(200)

  stageName String
  slug      String  @unique
  headline  String?
  bio       String?

  gender      Gender
  orientation Orientation
  tier        ModelTier   @default(STANDARD)

  birthYear Int?
  country   String?
  languages String[] @default([])
  tags      String[] @default([])

  /// Codigos ISO 3166-1 alpha-2 desde los que este perfil NO es visible.
  /// Lo gestiona la propia modelo desde /dashboard/model/privacy.
  blockedCountries String[] @default([])

  avatarUrl String?
  coverUrl  String?

  // ---------------------------------------------------------------------------
  // TARIFAS POR MINUTO, EN CENTITOKENS (1 token = 100 centitokens)
  //
  // La creadora puede pedir desde 17,5 hasta 250 tokens/min, y el minimo tiene
  // decimales, asi que un Int de tokens no sirve. Se guardan x100 para que el
  // calculo del cobro siga siendo aritmetica entera (ver src/lib/rates.ts):
  //   1750 = 17,5 tokens/min   2500 = 25 (default)   25000 = 250 tokens/min
  // ---------------------------------------------------------------------------
  vipRateCentitokens     Int @default(2500)
  privateRateCentitokens Int @default(2500)
  /// Minutos que se facturan como minimo en una llamada de pago
  minPrivateMinutes      Int @default(5)

  // Suscripcion mensual (fan club): contenido exclusivo + descuento en llamadas
  subscriptionEnabled         Boolean @default(false)
  subscriptionPriceTokens     Int     @default(0)
  /// % de descuento en tarifas por minuto para suscriptores activos
  subscriptionDiscountPercent Int     @default(15)
  subscribersCount            Int     @default(0)

  // Mensajeria privada: el primer mensaje se paga; para seguir escribiendo
  // el usuario debe mantener saldo positivo en su monedero
  messagingEnabled   Boolean @default(false)
  messagePriceTokens Int     @default(0)

  // Disponibilidad y estado
  isVipEnabled      Boolean   @default(false)
  acceptsBookings   Boolean   @default(true)
  isOnline          Boolean   @default(false)
  isAvailableForVip Boolean   @default(false)
  lastOnlineAt      DateTime?

  // ---------------------------------------------------------------------------
  // MENSAJE AUTOMATICO DE BIENVENIDA
  //
  // Se envia a las primeras personas que entran al perfil o al directo. Lo
  // manda la creadora, asi que abrir la conversacion es GRATIS para quien lo
  // recibe; la foto adjunta puede llevar precio y se desbloquea aparte.
  // El tope diario evita que una visita masiva vacie la lista de contactos.
  // ---------------------------------------------------------------------------
  autoGreetingEnabled     Boolean @default(false)
  autoGreetingText        String?
  /// Clave privada en S3/R2 de la foto que se adjunta (opcional)
  autoGreetingAssetKey    String?
  autoGreetingAssetMime   String?
  /// Clave de la miniatura difuminada que SI se ve sin pagar
  autoGreetingPreviewKey  String?
  /// 0 = la foto va gratis; >0 hay que desbloquearla
  autoGreetingPriceTokens Int     @default(0)
  /// Cuantos saludos como maximo por dia natural
  autoGreetingDailyLimit  Int     @default(20)
  autoGreetingSentToday   Int     @default(0)
  /// Dia (UTC) al que corresponde autoGreetingSentToday
  autoGreetingCounterDay  String?

  // ---------------------------------------------------------------------------
  // DIRECTOS
  // ---------------------------------------------------------------------------
  /// Solo se puede activar con el KYC aprobado (ver setLiveEnabledAction).
  liveEnabled      Boolean  @default(false)
  /// Clave de emision para OBS. Se regenera a peticion de la creadora.
  streamKey        String?  @unique
  /// Palabras que se ocultan del chat de sus directos (en minusculas).
  liveBlockedWords String[] @default([])
  /// Menu de propinas de sus directos: [{ id, label, tokens }].
  liveTipMenu      Json?

  // Metricas (denormalizadas para el catalogo)
  ratingAvg         Float @default(0)
  ratingCount       Int   @default(0)
  totalCalls        Int   @default(0)
  totalMinutes      Int   @default(0)
  totalTokensEarned Int   @default(0)
  followersCount    Int   @default(0)
  postsCount        Int   @default(0)
  /// Visitas al perfil acumuladas (el detalle esta en ProfileVisit)
  profileViews      Int   @default(0)

  kycStatus KycStatus @default(NOT_SUBMITTED)

  // ---------------------------------------------------------------------------
  // PERFIL ATENDIDO POR IA
  //
  // isAi hace que los mensajes entrantes los conteste un modelo de lenguaje en
  // vez de una persona. NO es un detalle de implementacion que se pueda ocultar:
  // la mensajeria se cobra en tokens, asi que un usuario que paga creyendo que
  // habla con una persona real estaria siendo enganado. La interfaz muestra la
  // etiqueta "IA" en el catalogo, en el perfil y en cada mensaje generado, y el
  // prompt del sistema le prohibe afirmar que es humana.
  // ---------------------------------------------------------------------------
  isAi Boolean @default(false)

  /// Personalidad e instrucciones que se inyectan en el system prompt.
  aiPersona String?

  /// Model ID de Anthropic con el que responde este perfil.
  aiModel String @default("claude-opus-5")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings         Booking[]
  availability     AvailabilitySlot[]
  kycVerifications KycVerification[]
  payoutRequests   PayoutRequest[]
  reviews          Review[]
  followers        Follow[]
  subscribers      Subscription[]
  contentRequests  ContentRequest[]
  conversations    Conversation[]
  posts            Post[]
  vaultPacks       VaultPack[]
  creatorOffers    CreatorOffer[]
  streams          LiveStream[]
  liveViews        LiveView[]
  visits           ProfileVisit[]
  greetings        AutoGreetingLog[]
  vaultFolders     VaultFolder[]
  vaultItems       VaultItem[]

  @@index([isOnline, isVipEnabled])
  @@index([gender, tier])
  @@index([slug])
  @@index([liveEnabled])
  @@map("model_profiles")
}

model AvailabilitySlot {
  id      String @id @default(cuid())
  modelId String

  /// 0 = domingo ... 6 = sabado
  weekday     Int
  /// Minutos desde medianoche (UTC del modelo), ej. 20:00 => 1200
  startMinute Int
  endMinute   Int
  timezone    String  @default("UTC")
  isActive    Boolean @default(true)

  model ModelProfile @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, weekday, startMinute])
  @@index([modelId, weekday])
  @@map("availability_slots")
}

model Review {
  id      String  @id @default(cuid())
  modelId String
  userId  String
  rating  Int
  comment String?

  createdAt DateTime @default(now())

  model ModelProfile @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, userId])
  @@index([modelId])
  @@map("reviews")
}

/// Seguir a una persona que no es creadora (red social). Seguir a una
/// creadora sigue usando `Follow`, que alimenta el feed "Siguiendo".
model UserFollow {
  id          String @id @default(cuid())
  followerId  String
  followingId String

  createdAt DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
  @@map("user_follows")
}

model Follow {
  id      String @id @default(cuid())
  userId  String
  modelId String

  /// Campanita del fan: avisarle cuando entre en directo / cuando publique.
  notifyLive  Boolean @default(true)
  notifyPosts Boolean @default(true)

  createdAt DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  model ModelProfile @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([userId, modelId])
  @@index([modelId])
  @@index([userId])
  @@map("follows")
}

model Subscription {
  id      String @id @default(cuid())
  userId  String
  modelId String

  status SubscriptionStatus @default(ACTIVE)

  /// Snapshot del precio y descuento vigentes al momento de suscribirse
  priceTokens     Int
  discountPercent Int

  startedAt        DateTime  @default(now())
  /// Hasta cuando cubre el pago actual (sin renovacion automatica: al
  /// vencer, deja de estar activa hasta que el usuario vuelva a suscribirse)
  currentPeriodEnd DateTime
  cancelledAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  model        ModelProfile  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, modelId])
  @@index([modelId, status])
  @@index([userId, status])
  @@map("subscriptions")
}

/// Pedido de contenido a medida: el usuario describe lo que quiere, la
/// modelo cotiza, el usuario paga y la modelo lo entrega por chat (gratis).
model ContentRequest {
  id      String @id @default(cuid())
  userId  String
  modelId String

  status      ContentRequestStatus @default(PENDING)
  description String

  quotedTokens Int?
  modelNote    String?

  /// Entregado por chat: el mensaje con los archivos (ya pagado).
  deliveredMessageId String? @unique

  createdAt   DateTime  @default(now())
  quotedAt    DateTime?
  paidAt      DateTime?
  deliveredAt DateTime?

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  model            ModelProfile  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  deliveredMessage Message?      @relation(fields: [deliveredMessageId], references: [id], onDelete: SetNull)
  transactions     Transaction[]

  @@index([modelId, status])
  @@index([userId, status])
  @@map("content_requests")
}

/// Conversacion privada usuario <-> modelo. Abrirla cuesta tokens (pago
/// unico); para seguir escribiendo el usuario debe mantener saldo positivo.
model Conversation {
  id      String @id @default(cuid())
  userId  String
  modelId String

  /// Precio pagado para desbloquearla, guardado como referencia
  unlockPriceTokens Int
  lastMessageAt     DateTime  @default(now())
  /// La abrio la creadora (gratis) en vez del fan.
  startedByModel    Boolean   @default(false)
  /// false = el chat existe solo por un pedido o una cita: el fan ve y
  /// gestiona esas tarjetas, pero para escribir tiene que abrir el chat al
  /// precio del creador (como cualquier otro chat de pago).
  chatUnlocked      Boolean   @default(true)
  /// null = solicitud pendiente: la abrio la creadora y el fan aun no la
  /// acepto ni respondio. Las que abre y paga el fan nacen aceptadas.
  acceptedAt        DateTime?
  /// Hasta cuando ha leido cada lado (para el contador de no leidos).
  userReadAt        DateTime?
  modelReadAt       DateTime?

  createdAt DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  model        ModelProfile  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  messages     Message[]
  transactions Transaction[]

  @@unique([userId, modelId])
  @@index([modelId, lastMessageAt])
  @@map("conversations")
}

/// Chat gratis entre dos cuentas que no es fan -> creadora (fan con fan,
/// creadora con creadora). userAId < userBId: un solo chat por pareja.
model PeerChat {
  id            String    @id @default(cuid())
  userAId       String
  userBId       String
  /// Quien escribio primero.
  createdById   String
  /// null = solicitud: quien la recibio aun no la acepto ni respondio.
  acceptedAt    DateTime?
  lastMessageAt DateTime  @default(now())
  /// Hasta cuando ha leido cada persona (para el contador de no leidos).
  readAtA       DateTime?
  readAtB       DateTime?
  createdAt     DateTime  @default(now())

  userA    User          @relation("PeerChatA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User          @relation("PeerChatB", fields: [userBId], references: [id], onDelete: Cascade)
  messages PeerMessage[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
  @@map("peer_chats")
}

model PeerMessage {
  id        String   @id @default(cuid())
  chatId    String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  chat   PeerChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("peer_messages")
}

model Message {
  id             String @id @default(cuid())
  conversationId String
  senderId       String

  // Puede ir vacio si el mensaje es solo un archivo adjunto.
  body String?

  /// true si lo genero el asistente de un perfil isAi. La interfaz lo etiqueta
  /// para que el usuario sepa siempre que no le contesta una persona.
  isAiGenerated Boolean @default(false)

  createdAt DateTime @default(now())

  conversation     Conversation       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           User               @relation(fields: [senderId], references: [id], onDelete: Cascade)
  attachment       MessageAttachment?
  /// Pedido a medida que se entrego con este mensaje.
  deliveredRequest ContentRequest?

  @@index([conversationId, createdAt])
  @@map("messages")
}

/// Archivo adjunto a un mensaje. Si priceTokens es 0 es de acceso libre para
/// quien reciba el mensaje; si no, hay que desbloquearlo (ver
/// MessageAttachmentUnlock). Puede llevar varios archivos (ver MessageAttachmentFile).
model MessageAttachment {
  id        String @id @default(cuid())
  messageId String @unique

  storageKey  String
  mimeType    String
  sizeBytes   Int?
  priceTokens Int     @default(0)
  /// Enviado desde la Boveda (para saber que ya se le envio / que ya compro).
  vaultItemId String?

  createdAt DateTime @default(now())

  message      Message                   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  vaultItem    VaultItem?                @relation(fields: [vaultItemId], references: [id], onDelete: SetNull)
  /// Todos los archivos del envio (uno o varios, con UN precio y UNA compra).
  /// storageKey/mimeType de arriba son los del primero, como portada.
  files        MessageAttachmentFile[]
  unlocks      MessageAttachmentUnlock[]
  transactions Transaction[]

  @@index([vaultItemId])
  @@map("message_attachments")
}

/// Un archivo dentro de un envio de pago del chat.
model MessageAttachmentFile {
  id           String  @id @default(cuid())
  attachmentId String
  storageKey   String
  /// Miniatura diminuta y borrosa que ve el fan antes de pagar.
  previewKey   String?
  mimeType     String
  sizeBytes    Int?
  /// Si salio de la Boveda (para saber que ya se le envio / que ya compro).
  vaultItemId  String?
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())

  attachment MessageAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  vaultItem  VaultItem?        @relation(fields: [vaultItemId], references: [id], onDelete: SetNull)

  @@index([attachmentId, sortOrder])
  @@index([vaultItemId])
  @@map("message_attachment_files")
}

model MessageAttachmentUnlock {
  id           String @id @default(cuid())
  userId       String
  attachmentId String
  tokensSpent  Int

  createdAt DateTime @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachment MessageAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([userId, attachmentId])
  @@index([userId, createdAt])
  @@map("message_attachment_unlocks")
}

model Notification {
  id     String           @id @default(cuid())
  userId String
  type   NotificationType

  title String
  body  String?
  // Ruta relativa a donde lleva la notificacion (ej. /models/valentinavip).
  link  String?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// =============================================================================
// CONTENIDO DE PAGO
// =============================================================================

// =============================================================================
// LLAMADAS Y MATCHMAKING
// =============================================================================

model CallSession {
  id     String     @id @default(cuid())
  type   CallType
  status CallStatus @default(PENDING)

  callerId String
  calleeId String?

  /// Nombre unico de la sala (LiveKit) o del canal de senalizacion P2P
  roomName String @unique

  /// Tarifa aplicada en CENTITOKENS/minuto (0 en RANDOM gratuito).
  /// 1 token = 100 centitokens; ver src/lib/rates.ts.
  rateCentitokens  Int     @default(0)
  /// Minimo que paga el fan si ES EL quien cuelga antes (lo fija el creador
  /// al llamar). Si cuelga el creador antes, solo se cobra lo usado.
  minBilledSeconds Int     @default(0)
  /// Oferta del creador con la que empezo (happy hour, primera llamada, cupon).
  creatorOfferId   String?

  startedAt    DateTime?
  endedAt      DateTime?
  /// Ultima marca de cobro procesada, base del calculo incremental
  lastBilledAt DateTime?

  billedSeconds     Int @default(0)
  tokensSpent       Int @default(0)
  tokensEarned      Int @default(0)
  platformFeeTokens Int @default(0)

  endReason CallEndReason?
  bookingId String?        @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  caller       User              @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee       User?             @relation("CallCallee", fields: [calleeId], references: [id], onDelete: SetNull)
  booking      Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  billingTicks CallBillingTick[]
  gifts        Gift[]
  transactions Transaction[]
  reports      Report[]
  queueEntries MatchQueueEntry[]

  @@index([callerId, createdAt])
  @@index([calleeId, createdAt])
  @@index([status, type])
  @@map("call_sessions")
}

model CallBillingTick {
  id        String @id @default(cuid())
  sessionId String

  seconds        Int
  tokensCharged  Int
  tokensCredited Int
  feeTokens      Int @default(0)

  createdAt DateTime @default(now())

  session CallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("call_billing_ticks")
}

model MatchQueueEntry {
  id     String      @id @default(cuid())
  userId String
  mode   QueueMode
  status QueueStatus @default(WAITING)

  // Filtros de emparejamiento
  genderPreference      Gender[]      @default([])
  orientationPreference Orientation[] @default([])
  countryPreference     String?
  minAge                Int?

  /// Genero/rol declarado del usuario en cola (para el matching reciproco)
  selfGender Gender?

  /// Pais ISO-3166 alpha-2 resuelto al entrar en cola. Se usa para no
  /// emparejar a un usuario con una modelo que bloquea su pais.
  selfCountry String?
  /// Todos sus paises conocidos (actual e historicos) y si entraba con VPN.
  selfCountries String[] @default([])
  selfVpn       Boolean  @default(false)

  /// Sala asignada al emparejar
  matchedSessionId String?
  matchedWithId    String?

  /// Heartbeat: entradas sin refrescar se consideran muertas
  heartbeatAt DateTime @default(now())
  expiresAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session CallSession? @relation(fields: [matchedSessionId], references: [id], onDelete: SetNull)

  @@index([mode, status, heartbeatAt])
  @@index([userId, status])
  @@map("match_queue_entries")
}

/// Evita reemparejar a dos usuarios que se saltaron o bloquearon
model BlockedPair {
  id        String    @id @default(cuid())
  blockerId String
  blockedId String
  isSkip    Boolean   @default(false)
  expiresAt DateTime?

  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@map("blocked_pairs")
}

model Gift {
  id        String  @id @default(cuid())
  sessionId String?
  /// Regalo enviado durante un directo (excluyente con sessionId)
  streamId  String?

  senderId   String
  receiverId String

  tokens  Int
  emoji   String?
  message String?

  createdAt DateTime @default(now())

  session     CallSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  stream      LiveStream?  @relation(fields: [streamId], references: [id], onDelete: SetNull)
  sender      User         @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User         @relation("GiftReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  transaction Transaction?

  @@index([sessionId])
  @@index([streamId, createdAt])
  @@index([receiverId, createdAt])
  @@map("gifts")
}

// =============================================================================
// RESERVAS (AGENDA)
// =============================================================================

model Booking {
  id      String        @id @default(cuid())
  userId  String
  modelId String
  status  BookingStatus @default(PENDING_CONFIRMATION)

  startsAt        DateTime
  durationMinutes Int
  /// Tarifa en CENTITOKENS/minuto congelada al reservar (ver src/lib/rates.ts)
  rateCentitokens Int
  /// Tokens retenidos al crear la reserva
  totalTokens     Int

  userNote  String?
  modelNote String?

  confirmedAt    DateTime?
  cancelledAt    DateTime?
  completedAt    DateTime?
  refundedTokens Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation("BookingUser", fields: [userId], references: [id], onDelete: Cascade)
  model        ModelProfile  @relation(fields: [modelId], references: [id], onDelete: Cascade)
  callSession  CallSession?
  transactions Transaction[]

  @@index([userId, startsAt])
  @@index([modelId, startsAt])
  @@index([status, startsAt])
  @@map("bookings")
}

// =============================================================================
// KYC / VERIFICACION DE IDENTIDAD
// =============================================================================

model KycVerification {
  id      String    @id @default(cuid())
  modelId String
  status  KycStatus @default(PENDING)

  fullLegalName  String
  birthDate      DateTime
  country        String
  documentType   DocumentType
  documentNumber String?

  // Claves privadas en S3/R2 (acceso solo con URL firmada de admin)
  documentFrontKey   String
  documentBackKey    String?
  selfieKey          String
  /// Selfie sujetando el documento + nota manuscrita (2257 compliance)
  handwrittenNoteKey String?

  reviewerId      String?
  reviewNotes     String?
  rejectionReason String?

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  expiresAt   DateTime?

  model    ModelProfile @relation(fields: [modelId], references: [id], onDelete: Cascade)
  reviewer User?        @relation("KycReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([modelId])
  @@map("kyc_verifications")
}

// =============================================================================
// PAYOUTS
// =============================================================================

model PayoutRequest {
  id      String       @id @default(cuid())
  /// Quien cobra: una creadora (modelId) o un reclutador (recruiterId).
  modelId     String?
  recruiterId String?
  status  PayoutStatus @default(REQUESTED)

  /// Tokens brutos que la creadora pidio retirar (lo que se le debita)
  tokens      Int
  /// Comision de retiro retenida (10% por defecto), en tokens
  feeTokens   Int    @default(0)
  /// tokens - feeTokens: lo que realmente se le transfiere
  netTokens   Int    @default(0)
  /// Importe en centavos correspondiente a netTokens
  amountCents Int
  currency    String @default("USD")

  method PayoutMethod

  /// Datos de cobro CIFRADOS (AES-256-GCM, ver src/lib/crypto.ts).
  /// Nunca se exponen en claro: solo un admin puede descifrarlos.
  destination       String
  /// Version enmascarada para mostrar en listados sin descifrar (ej. "****4321")
  destinationMasked String?

  processorId     String?
  notes           String?
  rejectionReason String?
  externalRef     String?

  requestedAt DateTime  @default(now())
  processedAt DateTime?
  paidAt      DateTime?

  model        ModelProfile? @relation(fields: [modelId], references: [id], onDelete: Cascade)
  recruiter    Recruiter?    @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  processor    User?         @relation("PayoutProcessor", fields: [processorId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([status, requestedAt])
  @@index([modelId])
  @@index([recruiterId])
  @@map("payout_requests")
}

// =============================================================================
// MODERACION
// =============================================================================

model Report {
  id String @id @default(cuid())

  reporterId String
  reportedId String
  sessionId  String?
  /// Que se denuncio: "profile", "post:<id>", "chat:<id>", "conversation:<id>".
  context    String?

  reason       ReportReason
  details      String?
  /// Capturas/evidencia (claves S3)
  evidenceKeys String[]     @default([])

  status      ReportStatus @default(OPEN)
  reviewerId  String?
  resolution  String?
  actionTaken String?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  reporter User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User         @relation("ReportedUser", fields: [reportedId], references: [id], onDelete: Cascade)
  reviewer User?        @relation("ReportReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  session  CallSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedId])
  @@map("reports")
}

model AuditLog {
  id      String  @id @default(cuid())
  actorId String?

  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PlatformSetting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt

  @@map("platform_settings")
}

// =============================================================================
// FEED SOCIAL
//
// El feed es el modo de descubrimiento principal de la app: /feed muestra todo
// el catalogo y /feed/siguiendo solo a quien sigues. Una publicacion LOCKED se
// ve SIEMPRE borrosa hasta que se paga: la imagen real nunca sale del bucket
// privado, lo que viaja al navegador es `previewKey`, una miniatura de 32 px
// difuminada al subirla. Difuminar con CSS no serviria: el original estaria en
// el HTML y bastaria con quitar el filtro desde el inspector.
// =============================================================================

model Post {
  id      String @id @default(cuid())
  modelId String

  body       String?
  visibility PostVisibility @default(PUBLIC)

  /// Precio de desbloqueo. Obligatorio (>0) si visibility = LOCKED.
  priceTokens Int     @default(0)
  isPublished Boolean @default(true)

  likeCount       Int       @default(0)
  commentCount    Int       @default(0)
  unlockCount     Int       @default(0)
  /// Personas distintas que la han visto en el feed (ver PostImpression).
  viewCount       Int       @default(0)
  tokensEarned    Int       @default(0)
  /// EXCLUSIVA DE DIRECTO: no sale en el feed ni en el perfil (se queda con
  /// isPublished = false) y solo se vende desde el menu "Pideme" de sus
  /// directos. Fecha en que la creadora la dejo lista. null = normal.
  liveExclusiveAt DateTime?
  /// Retirada por moderacion: deja de verse y la creadora no puede
  /// volver a publicarla.
  removedAt       DateTime?
  removedReason   String?
  /// Tiempo total que la han mirado (ms, max 60 s por persona).
  watchMs         BigInt    @default(0)
  /// Personas que vieron el video (casi) entero.
  completions     Int       @default(0)
  /// Personas que la pasaron de largo (menos de 1,5 s en pantalla).
  skips           Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  model        ModelProfile     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  assets       PostAsset[]
  unlocks      PostUnlock[]
  likes        PostLike[]
  comments     PostComment[]
  transactions Transaction[]
  poll         PostPoll?
  impressions  PostImpression[]
  hides        PostHide[]

  @@index([isPublished, createdAt])
  @@index([modelId, createdAt])
  @@index([modelId, liveExclusiveAt])
  @@map("posts")
}

model PostAsset {
  id     String @id @default(cuid())
  postId String

  /// Clave privada del original. Solo se firma para quien ha desbloqueado.
  storageKey  String
  /// Miniatura difuminada, servible a cualquiera. Sin ella un post LOCKED
  /// no muestra nada.
  previewKey  String?
  mimeType    String
  sizeBytes   Int?
  width       Int?
  height      Int?
  durationSec Int?
  sortOrder   Int     @default(0)
  /// Huella (SHA-256) del archivo: para que no se repita entre chat y directos.
  contentHash String?

  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([contentHash])
  @@index([postId, sortOrder])
  @@map("post_assets")
}

model PostUnlock {
  id          String @id @default(cuid())
  userId      String
  postId      String
  tokensSpent Int

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("post_unlocks")
}

/// Encuesta de una publicacion (como mucho una por publicacion).
model PostPoll {
  id         String    @id @default(cuid())
  postId     String    @unique
  question   String
  /// Cierre de la votacion. Tras esta fecha solo se ven los resultados.
  endsAt     DateTime?
  /// Contador desnormalizado: evita sumar votos en cada tarjeta del feed.
  totalVotes Int       @default(0)

  createdAt DateTime @default(now())

  post    Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  options PostPollOption[]
  votes   PostPollVote[]

  @@map("post_polls")
}

model PostPollOption {
  id        String @id @default(cuid())
  pollId    String
  text      String
  sortOrder Int    @default(0)
  voteCount Int    @default(0)

  poll  PostPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PostPollVote[]

  @@index([pollId, sortOrder])
  @@map("post_poll_options")
}

/// Un voto por persona y encuesta (el @@unique lo garantiza en la BD).
model PostPollVote {
  id       String @id @default(cuid())
  pollId   String
  optionId String
  userId   String

  createdAt DateTime @default(now())

  poll   PostPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PostPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([optionId])
  @@map("post_poll_votes")
}

model PostLike {
  id     String @id @default(cuid())
  userId String
  postId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("post_likes")
}

model PostComment {
  id     String @id @default(cuid())
  userId String
  postId String
  body   String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("post_comments")
}

// =============================================================================
// DIRECTOS (LIVE STREAMING)
//
// Solo emiten creadoras con KYC aprobado. Dos caminos de entrada:
//   BROWSER  -> la camara publica directo a LiveKit por WebRTC.
//   OBS_RTMP -> LiveKit Ingress expone una URL rtmp:// + clave; OBS publica
//               ahi y el ingress reenvia el video a la sala.
// Los espectadores reciben un token de SOLO SUSCRIPCION (canPublish = false):
// sin eso cualquiera podria publicar su camara en el directo de otra persona.
// =============================================================================

model LiveStream {
  id      String           @id @default(cuid())
  modelId String
  status  LiveStreamStatus @default(PREPARING)
  source  LiveStreamSource @default(BROWSER)

  title    String?
  /// Sala de LiveKit
  roomName String  @unique

  /// Identificador del ingress en LiveKit (solo OBS_RTMP)
  ingressId String?
  /// URL rtmp:// que se pega en OBS (solo OBS_RTMP)
  rtmpUrl   String?
  /// Clave de emision que se pega en OBS. Secreto: solo la ve su dueña.
  streamKey String?

  viewerCount  Int @default(0)
  viewerPeak   Int @default(0)
  /// Entradas acumuladas a la sala (no personas distintas: quien recarga
  /// la pagina cuenta otra vez). Las personas distintas salen de ProfileVisit.
  totalJoins   Int @default(0)
  giftsCount   Int @default(0)
  tokensEarned Int @default(0)

  /// Meta de tokens visible en el directo ("500 tokens -> bailo").
  /// goalProgress cuenta lo que pagan los fans desde que se puso la meta.
  /// La creadora acepta privados 1 a 1 durante este directo (se le pregunta
  /// al empezar): los espectadores ven el boton para llamarle.
  acceptsPrivate Boolean @default(false)

  goalLabel     String?
  goalTokens    Int?
  goalProgress  Int       @default(0)
  goalReachedAt DateTime?

  startedAt DateTime?
  endedAt   DateTime?

  // ---------------------------------------------------------------------------
  // CONTROLES EN VIVO (menu "Mas" de la creadora; ver actions/live-controls.ts)
  // ---------------------------------------------------------------------------
  /// En pausa ("vuelvo enseguida") desde esta fecha. null = emitiendo.
  pausedAt                 DateTime?
  /// Los espectadores ven la imagen volteada horizontalmente.
  mirrored                 Boolean        @default(false)
  /// Mensaje fijo arriba del chat.
  pinnedMessage            String?
  /// Quien puede verlo: todos, solo suscriptores o con entrada pagada.
  accessMode               LiveAccessMode @default(PUBLIC)
  /// Precio de la entrada (solo PAID).
  ticketTokens             Int?
  /// En un directo de pago, sus suscriptores entran sin pagar.
  ticketFreeForSubscribers Boolean        @default(true)
  /// Donde ha colocado la creadora cada panel (meta, encuesta, fijado):
  /// { poll: { x, y } } en fracciones del escenario (0-1). Ver lib/live-state.ts.
  widgetLayout             Json?
  /// El menu de propinas se ve como panel sobre el directo.
  tipMenuOnScreen          Boolean        @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  model        ModelProfile   @relation(fields: [modelId], references: [id], onDelete: Cascade)
  gifts        Gift[]
  transactions Transaction[]
  views        LiveView[]
  polls        LivePoll[]
  tickets      LiveTicket[]
  sanctions    LiveSanction[]

  @@index([status, startedAt])
  @@index([modelId, createdAt])
  @@map("live_streams")
}

enum LiveAccessMode {
  PUBLIC
  /// Solo sus suscriptores activos
  SUBSCRIBERS
  /// Entrada pagada en tokens (una vez por directo)
  PAID
}

/// Encuesta lanzada durante un directo. Un voto por persona.
model LivePoll {
  id       String    @id @default(cuid())
  streamId String
  question String
  options  String[]
  closedAt DateTime?

  createdAt DateTime @default(now())

  stream LiveStream     @relation(fields: [streamId], references: [id], onDelete: Cascade)
  votes  LivePollVote[]

  @@index([streamId, createdAt])
  @@map("live_polls")
}

model LivePollVote {
  id     String @id @default(cuid())
  pollId String
  userId String
  /// Indice de la opcion elegida
  option Int

  createdAt DateTime @default(now())

  poll LivePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@map("live_poll_votes")
}

/// Entrada pagada a un directo de pago (una por persona y directo).
model LiveTicket {
  id       String @id @default(cuid())
  streamId String
  userId   String
  tokens   Int

  createdAt DateTime @default(now())

  stream LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@unique([streamId, userId])
  @@map("live_tickets")
}

/// Sancion de la creadora a un espectador durante un directo.
/// MUTE: no puede escribir. KICK: no puede volver a entrar.
model LiveSanction {
  id       String @id @default(cuid())
  streamId String
  userId   String
  kind     String

  createdAt DateTime @default(now())

  stream LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@unique([streamId, userId, kind])
  @@map("live_sanctions")
}

/// Cuanto tiempo ha mirado cada persona cada directo. Es la senal de
/// retencion del algoritmo de directos: un directo del que la gente no se va
/// sube, uno que se salta en segundos baja (ver lib/live-rank.ts).
model LiveView {
  id       String @id @default(cuid())
  streamId String
  userId   String
  modelId  String

  /// Segundos mirando con la pestana visible, acumulados.
  seconds Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stream LiveStream   @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  model  ModelProfile @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([streamId, userId])
  @@index([userId, updatedAt])
  @@index([modelId])
  @@map("live_views")
}

// =============================================================================
// ANALITICAS DE CREADORA
// =============================================================================

/// Una visita al perfil, al directo o a una publicacion. Es la base del panel
/// de analiticas: "quien me visita mas". Se deduplica por (perfil, visitante,
/// dia) para que recargar la pagina no infle el numero.
model ProfileVisit {
  id       String      @id @default(cuid())
  modelId  String
  /// null si la visita es de alguien sin cuenta
  viewerId String?
  source   VisitSource @default(PROFILE)

  /// Pais ISO-3166 alpha-2 resuelto en el momento de la visita
  country String?
  /// Dia UTC en formato YYYY-MM-DD, usado para deduplicar
  day     String

  visits    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  model  ModelProfile @relation(fields: [modelId], references: [id], onDelete: Cascade)
  viewer User?        @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([modelId, viewerId, source, day])
  @@index([modelId, createdAt])
  @@index([modelId, viewerId])
  @@map("profile_visits")
}

/// Registro de a quien ya se le mando el saludo automatico, para no repetirlo.
model AutoGreetingLog {
  id      String      @id @default(cuid())
  modelId String
  userId  String
  source  VisitSource @default(PROFILE)

  createdAt DateTime @default(now())

  model ModelProfile @relation(fields: [modelId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([modelId, userId])
  @@index([modelId, createdAt])
  @@map("auto_greeting_logs")
}

/// Una persona vio una publicacion en el feed (al menos 1 s en pantalla).
/// Sirve para no repetirle lo ya visto, para medir que tal funciona cada
/// publicacion (me gusta / vistas) y para repartir la visibilidad.
model PostImpression {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  /// Tiempo en pantalla acumulado (ms)
  dwellMs   Int      @default(0)
  /// Vio el video (casi) entero
  completed Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
  @@map("post_impressions")
}

/// "No me interesa": la publicacion deja de salirle y su creadora baja.
model PostHide {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("post_hides")
}

/// RECLUTADOR: alguien que no crea contenido y solo trae creadoras. Lo da de
/// alta el equipo (desde admin) con las condiciones negociadas con el. Cobra
/// un % de lo que venden sus creadoras, de la comision de la plataforma.
model Recruiter {
  id                String   @id @default(cuid())
  userId            String   @unique
  /// Codigo de su enlace: /reclutar/<code>
  code              String   @unique
  /// % de cada venta de sus creadoras (sale de la comision de la plataforma).
  commissionPercent Int      @default(3)
  /// Meses que cobra por cada creadora desde que se hizo creadora. null = siempre.
  months            Int?     @default(12)
  /// Cupo negociado: cuantas creadoras le cuentan como maximo. null = sin tope.
  maxCreators       Int?
  active            Boolean  @default(true)
  /// Fraccion de token acumulada (en centesimas) que aun no se le ha
  /// abonado: su % de ventas pequenas (un tramo de llamada de 1 token) no
  /// llega a un token entero, asi que se acumula hasta completarlo.
  commissionCarry   Int      @default(0)
  /// Notas internas de la negociacion (solo admin).
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user     User   @relation("RecruiterAccount", fields: [userId], references: [id], onDelete: Cascade)
  creators User[] @relation("RecruitedBy")
  payoutRequests PayoutRequest[]

  @@map("recruiters")
}

/// AVISO A TODOS: mensaje del equipo que llega como notificacion a un grupo.
model Announcement {
  id          String   @id @default(cuid())
  /// all | fans | creators | founders
  audience    String
  title       String
  body        String?
  link        String?
  sentCount   Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("announcements")
}

enum SupportStatus {
  /// Esperando respuesta del equipo
  OPEN
  /// El equipo respondio; esperando a la persona
  ANSWERED
  CLOSED
}

/// SOPORTE: una consulta de un usuario al equipo, con su conversacion.
model SupportTicket {
  id        String        @id @default(cuid())
  userId    String
  /// cuenta | pagos | retiros | contenido | verificacion | otro
  category  String
  subject   String
  status    SupportStatus @default(OPEN)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([status, updatedAt])
  @@index([userId, updatedAt])
  @@map("support_tickets")
}

model SupportMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  /// true = lo escribio el equipo
  fromStaff Boolean  @default(false)
  body      String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

/// Seccion de la Boveda: para enganchar (siempre gratis) o nivel de pago.
enum VaultSection {
  TEASER
  LEVEL_1
  LEVEL_2
  LEVEL_3
  SPECIAL
}

/// Carpeta propia de la creadora dentro de su Boveda ("Lenceria", "Ducha"...).
model VaultFolder {
  id        String   @id @default(cuid())
  modelId   String
  name      String
  createdAt DateTime @default(now())

  model ModelProfile @relation(fields: [modelId], references: [id], onDelete: Cascade)
  items VaultItem[]

  @@unique([modelId, name])
  @@map("vault_folders")
}

/// BOVEDA: contenido privado de la creadora, listo para enviar por chat
/// (ella o su equipo de chat) sin que el archivo salga de la plataforma.
model VaultItem {
  id          String       @id @default(cuid())
  modelId     String
  section     VaultSection
  folderId    String?
  storageKey  String
  mimeType    String
  sizeBytes   Int?
  /// Nota corta para quien envia ("lenceria roja").
  note        String?
  /// Precio propio; null = el del nivel. Los de TEASER siempre van gratis.
  priceTokens Int?
  createdAt   DateTime     @default(now())

  /// Miniatura borrosa (se crea la primera vez que se envia).
  previewKey String?

  /// Paquete al que pertenece: si lo tiene, solo se vende dentro del paquete.
  packId      String?
  /// Huella (SHA-256) del archivo: para que no se repita entre chat y directos.
  contentHash String?

  model           ModelProfile            @relation(fields: [modelId], references: [id], onDelete: Cascade)
  folder          VaultFolder?            @relation(fields: [folderId], references: [id], onDelete: SetNull)
  pack            VaultPack?              @relation(fields: [packId], references: [id], onDelete: SetNull)
  attachments     MessageAttachment[]
  attachmentFiles MessageAttachmentFile[]

  @@index([modelId, section, createdAt])
  @@index([modelId, contentHash])
  @@map("vault_items")
}

/// Paquete de la Boveda: varios archivos que se venden juntos por un precio.
model VaultPack {
  id          String   @id @default(cuid())
  modelId     String
  name        String
  priceTokens Int
  createdAt   DateTime @default(now())

  model ModelProfile @relation(fields: [modelId], references: [id], onDelete: Cascade)
  items VaultItem[]

  @@index([modelId, createdAt])
  @@map("vault_packs")
}

/// Movil u ordenador donde la persona activo los avisos (Web Push). Uno por
/// navegador; se borra solo cuando el servicio de avisos dice que ya no vale.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// PROMOCION DE TOKENS: el equipo rebaja el precio de todos los paquetes un
/// % durante unas fechas. Se aplica al cobrar (lib/token-promos.ts) y se
/// anuncia en el monedero y en los directos.
model TokenPromo {
  id          String   @id @default(cuid())
  /// Lo que ven los fans ("Black Friday", "Fin de semana loco")
  title       String
  /// % de descuento sobre el precio de cada paquete
  percentOff  Int
  startsAt    DateTime
  endsAt      DateTime
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([active, startsAt, endsAt])
  @@map("token_promos")
}

// =============================================================================
// OFERTAS DEL CREADOR
// -----------------------------------------------------------------------------
// Rebajas que lanza el propio creador. El descuento sale de SU precio: la
// plataforma cobra su % de lo que el fan paga de verdad, asi que nunca pierde.
//   HAPPY_HOUR   -X% en privados durante 1-3 h
//   FLASH_SALE   -X% en todo su contenido de pago durante 24-72 h
//   FIRST_MONTH  -X% en el primer mes de quien se suscribe por primera vez
//   FIRST_CALL   -X% en la primera videollamada de cada fan
//   COUPON       cupon personal para un fan (llamada o contenido), 24 h, 1 uso
// =============================================================================

enum CreatorOfferKind {
  HAPPY_HOUR
  FLASH_SALE
  FIRST_MONTH
  FIRST_CALL
  COUPON
}

enum CouponTarget {
  CALL
  CONTENT
}

model CreatorOffer {
  id         String           @id @default(cuid())
  modelId    String
  kind       CreatorOfferKind
  percentOff Int
  startsAt   DateTime         @default(now())
  /// null = sin fecha de fin (primer mes, primera llamada)
  endsAt     DateTime?
  active     Boolean          @default(true)
  /// Cupon: para que fan es y en que se usa.
  fanId      String?
  target     CouponTarget?
  usedAt     DateTime?
  /// Ventas hechas con la oferta y tokens que pagaron los fans.
  uses       Int              @default(0)
  tokensPaid Int              @default(0)
  createdAt  DateTime         @default(now())

  model ModelProfile @relation(fields: [modelId], references: [id], onDelete: Cascade)
  fan   User?        @relation("CouponFan", fields: [fanId], references: [id], onDelete: Cascade)

  @@index([modelId, kind, active])
  @@index([fanId, usedAt])
  @@map("creator_offers")
}

// =============================================================================
// DISTRIBUIDORES OFICIALES (revendedores de tokens)
// -----------------------------------------------------------------------------
// Compran tokens al por mayor (solo por transferencia bancaria, nunca con
// tarjeta) y los envian a fans verificados de su pais. Sus tokens ("stock")
// no estan en su monedero: no puede gastarlos ni retirarlos, solo enviarlos.
// Todo el programa esta apagado hasta que config.distributors.enabled = true.
// =============================================================================

enum DistributorStatus {
  ACTIVE
  SUSPENDED
}

enum DistributorOrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum DistributorPayMethod {
  WIRE
  USDT
}

model Distributor {
  id             String            @id @default(cuid())
  userId         String            @unique
  /// Nombre legal (persona o empresa) que figura en el contrato.
  legalName      String
  /// ISO 3166-1 alfa-2 del pais donde vende.
  country        String
  taxId          String?
  /// Como lo contactan los fans (WhatsApp, Telegram, email...). Publico.
  publicContact  String
  /// Paises donde vende (ISO alfa-2): su pais + los de sus metodos de cobro (syncCoverage).
  countries      String[]
  /// Metodos de pago que acepta: salen de sus metodos de cobro activos (syncCoverage).
  paymentMethods String[]
  status         DistributorStatus @default(ACTIVE)
  /// Lo pone el propio distribuidor: si ahora atiende pedidos o no.
  isAvailable    Boolean           @default(true)

  /// Precio especial por token (centavos) pactado con este distribuidor.
  /// null = precio por tramos segun el tamaño del lote (lo normal).
  centsPerToken    Int?
  /// Tope de tokens que puede enviar al dia (todos sus fans).
  dailyLimitTokens Int
  /// Tokens comprados y aun no enviados.
  stockTokens      Int  @default(0)

  /// Cumplimiento: identidad verificada, revisado en la lista OFAC, contrato firmado.
  idVerifiedAt       DateTime?
  sanctionsCheckedAt DateTime?
  contractSignedAt   DateTime?
  notes              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    DistributorOrder[]
  transfers DistributorTransfer[]
  accounts  DistributorAccount[]
  sales     DistributorSale[]

  @@index([status, country])
  @@map("distributors")
}

model DistributorOrder {
  id              String                 @id @default(cuid())
  distributorId   String
  tokens          Int
  /// Precio medio por token del lote, en milesimas de centavo (8700 = 8,7 ¢).
  centsPerToken   Int
  /// Descuento del tramo aplicado (0 si tenia precio especial).
  discountPercent Int                    @default(0)
  amountCents     Int
  paymentMethod   DistributorPayMethod   @default(WIRE)
  status          DistributorOrderStatus @default(PENDING)
  /// Referencia de la transferencia o hash de la transaccion USDT.
  paymentRef      String?
  /// Recibo del pago que sube el distribuidor (obligatorio para confirmar el lote).
  proofKey        String?
  proofUploadedAt DateTime?
  /// Motivo si el equipo rechaza el lote (no llego el pago...).
  rejectReason    String?
  confirmedById   String?
  paidAt          DateTime?
  createdAt       DateTime               @default(now())

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([distributorId, createdAt])
  @@map("distributor_orders")
}

model DistributorTransfer {
  id            String   @id @default(cuid())
  distributorId String
  toUserId      String
  tokens        Int
  /// Chat desde el que se envio (el fan lo pidio en la app).
  peerChatId    String?
  /// Pedido con garantia que lo origino.
  saleId        String?
  createdAt     DateTime @default(now())

  distributor Distributor @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  toUser      User        @relation("DistributorRecipient", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([distributorId, createdAt])
  @@index([toUserId, createdAt])
  @@map("distributor_transfers")
}

/// Cuenta de cobro de un distribuidor: un metodo de pago en un pais y una
/// moneda, con su precio. Los datos para pagar solo los ve el fan dentro de
/// un pedido.
model DistributorAccount {
  id            String   @id @default(cuid())
  distributorId String
  country       String
  /// ISO 4217 (MXN, COP, USD...)
  currency      String
  /// Clave de PAYMENT_METHODS (lib/distributor-shared)
  method        String
  /// "Nequi 300 000 0000 a nombre de Ana Torres"
  details       String
  /// (Antiguo, sin uso) precio por 100 tokens. Ahora cada metodo tiene sus paquetes.
  pricePer100   Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  distributor Distributor          @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  sales       DistributorSale[]
  packages    DistributorPackage[]

  @@index([distributorId, active])
  @@map("distributor_accounts")
}

/// Paquete que vende un distribuidor con un metodo: "50 tokens = 95 MXN".
/// El precio lo pone el; se le recomienda no ganar mas del 20%.
model DistributorPackage {
  id        String   @id @default(cuid())
  accountId String
  tokens    Int
  /// Precio en la moneda del metodo, en centesimas.
  price     Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  account DistributorAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sales   DistributorSale[]

  @@index([accountId, active])
  @@map("distributor_packages")
}

enum DistributorSaleStatus {
  /// Creado: los tokens del distribuidor quedan reservados. El fan debe pagar.
  AWAITING_PAYMENT
  /// El fan dice que pago. El distribuidor debe confirmar y liberar.
  PAID
  COMPLETED
  CANCELLED
  /// Lo revisa el equipo.
  DISPUTED
}

/// Compra con garantia entre un fan y un distribuidor, dentro de la web.
model DistributorSale {
  id                 String                @id @default(cuid())
  distributorId      String
  fanId              String
  accountId          String
  packageId          String?
  tokens             Int
  currency           String
  /// Lo que paga el fan, en centesimas de su moneda.
  amount             Int
  /// Lo que valian esos tokens al cambio oficial del dia (centesimas). Solo referencia para disputas.
  referenceAmount    Int
  status             DistributorSaleStatus @default(AWAITING_PAYMENT)
  /// Referencia del pago que pone el fan.
  paymentRef         String?
  /// Captura del comprobante (obligatoria al marcar "Ya pagué").
  paymentProofKey    String?
  expiresAt          DateTime
  paidAt             DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  disputedAt         DateTime?
  /// FAN o DISTRIBUTOR
  disputeBy          String?
  disputeReason      String?
  /// Prueba que sube quien abre la disputa (captura de su cuenta, del chat...).
  disputeEvidenceKey String?
  resolvedById       String?
  resolvedAt         DateTime?
  /// Lo que decidio el equipo y por que (lo ven el fan y el distribuidor).
  resolutionNote     String?
  /// Valoracion del fan: 1 bien, -1 mal.
  rating             Int?
  createdAt          DateTime              @default(now())

  distributor Distributor         @relation(fields: [distributorId], references: [id], onDelete: Cascade)
  fan         User                @relation("DistributorBuyer", fields: [fanId], references: [id], onDelete: Cascade)
  account     DistributorAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  package     DistributorPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([distributorId, status])
  @@index([fanId, createdAt])
  @@index([status, expiresAt])
  @@map("distributor_sales")
}
