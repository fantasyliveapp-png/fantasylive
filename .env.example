# =============================================================================
# FantasyLive - Variables de entorno
# Copia este archivo como `.env` para desarrollo local:
#   cp .env.example .env           (Linux/macOS)
#   Copy-Item .env.example .env    (Windows PowerShell)
# En Vercel: Project Settings -> Environment Variables (pega cada par KEY=VALUE)
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL)
# -----------------------------------------------------------------------------
# Local via docker-compose (usuario/pass/db definidos en docker-compose.yml)
DATABASE_URL="postgresql://fantasy:fantasy@localhost:5432/fantasylive?schema=public"

# DIRECT_URL es la conexion SIN pooling que Prisma usa para las migraciones.
# En local es identica a DATABASE_URL. NO puede quedar vacia: Prisma falla con
# P1012 "You must provide a nonempty direct URL".
DIRECT_URL="postgresql://fantasy:fantasy@localhost:5432/fantasylive?schema=public"

# En produccion (Neon / Supabase / RDS) sobre Vercel, separa ambas:
#   DATABASE_URL="postgresql://user:pass@host-pooler/db?sslmode=require&pgbouncer=true&connection_limit=1"
#   DIRECT_URL="postgresql://user:pass@host/db?sslmode=require"

# -----------------------------------------------------------------------------
# AUTENTICACION (NextAuth / Auth.js v5)
# -----------------------------------------------------------------------------
# Genera un secreto con: openssl rand -base64 32   (o `npx auth secret`)
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-bytes"
NEXTAUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-32-bytes"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# OAuth opcional (deja vacio para desactivar el proveedor)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="FantasyLive"
# Edad minima obligatoria (compliance 18+)
NEXT_PUBLIC_MIN_AGE="18"

# -----------------------------------------------------------------------------
# ECONOMIA DE TOKENS
# -----------------------------------------------------------------------------
# Valor de venta de 1 token al usuario, en centavos de USD (10 = $0.10)
TOKEN_VALUE_CENTS="10"
# Cuanto cobra la modelo por token ganado, en centavos.
# El reparto se aplica UNA SOLA VEZ, al gastar el usuario (ver
# PLATFORM_COMMISSION_PERCENT), asi que aqui el token se paga integro.
# Mantener igual a TOKEN_VALUE_CENTS para no cobrar comision dos veces.
MODEL_PAYOUT_CENTS_PER_TOKEN="10"
# Comision de la plataforma sobre tokens gastados (0-100).
# 50 => la plataforma retiene el 50% y la modelo se lleva el otro 50%.
PLATFORM_COMMISSION_PERCENT="50"
# Tokens de bienvenida al registrarse
SIGNUP_BONUS_TOKENS="25"
# Minimo de tokens para solicitar un retiro
MIN_PAYOUT_TOKENS="500"
# Intervalo de cobro por minuto en llamadas (segundos)
CALL_BILLING_INTERVAL_SECONDS="15"

# -----------------------------------------------------------------------------
# STREAMING / WEBRTC
# -----------------------------------------------------------------------------
# Proveedor de media: "livekit" (recomendado, funciona en Vercel) | "p2p"
NEXT_PUBLIC_MEDIA_PROVIDER="livekit"

# LiveKit Cloud -> https://cloud.livekit.io (plan gratuito disponible)
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
LIVEKIT_URL="wss://tu-proyecto.livekit.cloud"
NEXT_PUBLIC_LIVEKIT_URL="wss://tu-proyecto.livekit.cloud"

# Fallback WebRTC P2P: servidor de senalizacion (Socket.io) fuera de Vercel
# (Railway / Fly.io / VPS). Solo necesario si NEXT_PUBLIC_MEDIA_PROVIDER="p2p"
NEXT_PUBLIC_SIGNALING_URL="http://localhost:4000"
SIGNALING_SHARED_SECRET="cambia-esto"
# STUN/TURN
NEXT_PUBLIC_STUN_URLS="stun:stun.l.google.com:19302,stun:global.stun.twilio.com:3478"
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# -----------------------------------------------------------------------------
# ALMACENAMIENTO DE CONTENIDO (S3 / Cloudflare R2 / MinIO local)
# -----------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"          # MinIO local; R2: https://<accountid>.r2.cloudflarestorage.com
S3_REGION="auto"                              # AWS: us-east-1 | R2/MinIO: auto
S3_BUCKET="fantasylive-content"
S3_ACCESS_KEY_ID="fantasy"
S3_SECRET_ACCESS_KEY="fantasy123"
S3_FORCE_PATH_STYLE="true"                    # true para MinIO/R2, false para AWS S3
S3_PUBLIC_BASE_URL=""                         # CDN opcional para previews publicos
# Minutos de validez de las URLs firmadas de contenido desbloqueado
SIGNED_URL_TTL_MINUTES="15"

# -----------------------------------------------------------------------------
# PAGOS
# -----------------------------------------------------------------------------
# Proveedor activo: "stripe" | "ccbill" | "crypto" | "mock"
# "mock" acredita tokens al instante sin cobrar (ideal para pruebas locales)
PAYMENT_PROVIDER="mock"

# Stripe -> https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# CCBill (pasarela especializada en contenido adulto)
CCBILL_CLIENT_ACCNUM=""
CCBILL_CLIENT_SUBACC=""
CCBILL_FLEXFORM_ID=""
CCBILL_SALT=""
CCBILL_DATALINK_USER=""
CCBILL_DATALINK_PASS=""

# Crypto (NOWPayments / Coinbase Commerce)
CRYPTO_API_KEY=""
CRYPTO_IPN_SECRET=""

# -----------------------------------------------------------------------------
# MODERACION / COMPLIANCE
# -----------------------------------------------------------------------------
# Email al que llegan reportes y disputas
ADMIN_ALERT_EMAIL="admin@fantasylive.test"
# Fuerza KYC aprobado antes de que un modelo pueda emitir
REQUIRE_KYC_TO_STREAM="true"

# -----------------------------------------------------------------------------
# SEED (solo desarrollo local) - credenciales de los usuarios ficticios
# -----------------------------------------------------------------------------
SEED_PASSWORD="Password123!"

# -----------------------------------------------------------------------------
# RETIROS (PAYOUTS)
# -----------------------------------------------------------------------------
# Clave AES-256-GCM con la que se cifran los datos de cobro (IBAN, wallet
# TRC20, email de PayPal). OBLIGATORIA en produccion. Generala con:
#   openssl rand -base64 32
# Si la cambias, los destinos ya guardados dejan de poder descifrarse.
PAYOUT_ENCRYPTION_KEY=""

# -----------------------------------------------------------------------------
# GEOLOCALIZACION / BLOQUEO POR PAIS
# -----------------------------------------------------------------------------
# Leer el pais de las cabeceras del proxy (cf-ipcountry, x-real-ip...).
# Ponlo en "true" SOLO si hay un proxy delante que las sobrescribe (el nginx
# de deploy/nginx.conf lo hace). Con la app expuesta directa, cualquiera
# podria saltarse el bloqueo mandando la cabecera a mano.
GEO_TRUST_PROXY_HEADERS="true"
# Numero de proxies de confianza delante de la app (nginx solo = 1;
# Cloudflare + nginx = 2).
GEO_TRUSTED_PROXY_HOPS="1"
# Fuerza un pais concreto para pruebas de QA (ej. "ES"). Vacio en produccion.
GEO_OVERRIDE_COUNTRY=""

# -----------------------------------------------------------------------------
# MONITORIZACION
# -----------------------------------------------------------------------------
# Token para leer el detalle de /api/health sin ser admin (cabecera
# x-health-token). Vacio => el detalle solo lo ven los admins.
HEALTH_CHECK_TOKEN=""

# -----------------------------------------------------------------------------
# PAYPAL (pagos entrantes)
# -----------------------------------------------------------------------------
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
# "sandbox" para pruebas, "live" en produccion
PAYPAL_MODE="sandbox"
